# lumen configuration — the LOADABLE dev template (2026-11-15).
#
# Doctrine (workspace non-negotiable #1): the ENV FILE ITSELF never enters
# git — `env.yaml` is gitignored; committing a VALUE anywhere is a doctrine
# break. In production there IS no env.yaml: the pod reads its environment,
# rendered by ExternalSecrets from OpenBao kv/data/lumen/{env} (INFRA §5).
# In dev the values ride the Makefile's exported env (`make dev`) — ENV
# WINS over this file (viper precedence), so this file only fills the gaps
# for a bare `go run ./cmd/lumen all`.
#
# `make config-init` copies this file to ./env.yaml — only if absent, never
# clobbering an existing one. The machine-readable per-role key set is the
# code itself: `lumen config keys --role admin|cms|all` (the binding table
# in internal/config is the single source; this file mirrors it for humans,
# and a guard test proves every uncommented key here is a known binding).
#
# KEYS BELOW ARE THE VIPER KEYS the loader merges (same names as the
# binding table, minus the LUMEN_ prefix). Secrets carry EMPTY values on
# purpose; non-secrets carry the real dev defaults.

# ---- secrets: fill or let `make dev` export them (throwaway dev values) ----
db_url: ""                # postgres://… (dev twin: postgres://lumen:lumen-dev@localhost:5433/lumen?sslmode=disable)
session_jwt_secret: ""    # ADMIN PLANE ONLY; 32+ random bytes (dev: a throwaway; prod: Bao lumen/{env})

# ---- passkeys (WebAuthn): OPTIONAL — both unset = the feature is off ----
# webauthn_rp_id: "console.gofar.id"     # the domain the credentials bind to
# webauthn_origin: "https://console.gofar.id"  # full scheme+host (defaults to https:// + rp_id)
meili_key: ""             # engine master key (compose dev default: dev-meili-key)
media_access_key: ""      # devs3 twin: test / test (S3 creds; prod: Bao)
media_secret_key: ""

# ---- real defaults: the loader reads these as-is ----
port: "8080"                    # HTTP listen port (LUMEN_PORT wins over plain PORT env)
metrics_port: "9090"            # the UNROUTED /metrics listener (no-sidecar contract)
origin: ""                      # absolute base for feed URLs/redirects (dev: empty is correct)
admin_url: http://localhost:8080  # the cms plane's introspection edge (dev 'all' plane ignores it)
meili_url: http://localhost:7700
meili_index_posts: "posts"
meili_index_photos: "photos"
media_endpoint: http://localhost:4566   # devs3's port
media_region: us-east-1
media_bucket: lumen-media-dev
media_cdn_base: ""              # dev composes endpoint+bucket URLs; prod sets the CDN base
media_force_path: true
media_create_bucket: true       # dev-only escape hatch (prod never auto-creates)
media_prefix: ""                # object-key prefix; empty = the plain content-addressed shape

# ---- role pin (leave commented: unset = legacy 'all' dev plane) ----
# role: all                       # admin | cms | all

# ---- outbound timeouts (defaults live in code — internal/obs's registry;
#      MISSING or EMPTY key = default; uncomment to override) ----
# timeout_meilisearch: 2s                   # dep default; per-op overrides win
# timeout_meilisearch_index_upsert: 10s
# timeout_meilisearch_ensure: 30s
# timeout_cloudflare-r2: 10s
# timeout_cloudflare-r2_put: 30s
# timeout_openbao: 5s
# timeout_lumen-admin: 5s                   # the cms plane's introspection edge

# ---- env-only keys (NEVER read from this file — internal/bao consumes
#      them straight from the environment; a file value would be read by
#      nothing. `make dev-plane` exports them via the gitignored
#      dev-plane.env; absent = the /admin/bao surface honestly unmounts): ----
#   LUMEN_BAO_ADDR | LUMEN_BAO_ROLE_ID | LUMEN_BAO_SECRET_ID
#
# ---- CLI-only (never a server binding, not in `config keys`): ----
#   LUMEN_PASSWORD    the `lumen user` bootstrap verb; the password never
#                     travels in argv
