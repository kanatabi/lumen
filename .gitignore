# Secrets doctrine (workspace non-negotiable #1): the ENV FILE ITSELF is the
# thing that never enters git. Values live in Bao (lumen/{env}); this sample is
# schema documentation only.
.env
.env.*
!.env.example
!env.yaml.sample
*.local

# build artifacts — ROOT-ANCHORED (/lumen) on purpose: bare names match at
# ANY depth and silently ate cmd/lumen & cmd/seed for the whole milestone
# (branch audit caught it; a clone of the branch would not have compiled)
/bin/
/dist/
/lumen
/seed

# local data
pgdata/
*.db
